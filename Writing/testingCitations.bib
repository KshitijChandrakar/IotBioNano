@phdthesis{hong2025accessible,
  title = {An Accessible Wafer-Scale Approach for Sub-10 nm Nanogap Fabrication and Its Optical Applications},
  author = {Hong, Seongcheol},
  year = {2025},
  month = {February},
  school = {Seoul National University},
  address = {Seoul, South Korea},
  doi = {10.0000/000000189598},  
  url = {https://hdl.handle.net/10371/220196},
  note = {PhD Thesis. Advisor: Jongjin Cha},
  abstract = {The importance of sub-10 nm nanogap stems from their ability to significantly enhance local electromagnetic (EM) fields, unlocking unique quantum mechanical effects essential for nanooptics devices. Sub-10 nm nanogaps are typically fabricated using high-resolution techniques like electron beam lithography (EBL) and ion beam lithography, though both face limitations in throughput and reproducibility. Other advanced techniques such as nanoimprint lithography (NIL) and extreme ultraviolet (EUV) lithography could address these issues, but they also come with technical challenges. In 2013, atomic layer lithography (ALL) presented as a promising alternative, combining standard photolithography with atomic layer deposition (ALD). However, achieving uniform nanostructures on a wafer-scale remains challenging due to the reliance on mechanical peeling. In this paper, the advanced ALL method utilizes a photoresist layer as both a protective mask and a sacrificial layer in the fabrication process, enabling the production of a sub-10 nm slot antenna array across the entire wafer. Using this improved method, samples were fabricated on a 4-inch wafer, and the successful fabrication of sub-10 nm nanogap was verified through optical and electron microscopy observations. Additionally, theoretical analysis was complemented with terahertz time-domain spectroscopy (THz-TDS) measurements to observe variations in EM wave transmission characteristics across different locations on the wafer. The analysis revealed that all 57 samples fabricated across the entire wafer met the sub-10 nm standard, achieving a 100% yield. These observations confirmed the successful fabrication of uniform sub-10 nm nanogaps across the entire wafer. Furthermore, leveraging the unique advantages of the improved ALL method, wafer-scale sample fabrication, previously unattainable with the conventional ALL approach, was demonstrated. Examples include the fabrication of slot antenna arrays using non-noble metals such as Cu and Ag, nano-slit arrays extending over several centimeters, and dumbbell-shaped samples featuring Ti and Pt as electrodes with distinct electrical and optical properties. Moreover, leveraging the advantages of the advanced ALL method demonstrated above, I investigated energy harvesting from electromagnetic waves in the near-infrared (NIR) range through nanogap rectenna. I fabricated metal-insulator-metal (MIM) diode arrays and measured its current-voltage characteristics under light illumination. As a result, I observed optical rectification and verified its characteristics as a rectenna. In conclusion, the advancements of the ALL method presented in this study have significant implications for both the research community and industry. By addressing the limitations of earlier fabrication techniques, this method enables scalable, high-yield, and cost-effective production of sub-10 nm nanogap thereby enabling high-density integration in next-generation devices, spanning photonics, electronics, and energy transmission. This innovation will accelerate advancements across disciplines, making sub-10 nm nanotechnology a practical reality for both fundamental science and commercial applications.},
  keywords = {Sub-10nm Nanogap, Atomic Layer Lithography, Wafer-scale Nanofabrication, Optical rectification, Field enhancement},
  language = {English},
  type = {PhD Thesis},
  institution = {Seoul National University, Graduate School, Department of Physics and Astronomy},
}



